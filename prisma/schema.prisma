generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
}

enum RecordType {
  ENTRY
  EXIT
}

enum RecordSource {
  KIOSK
  ADMIN
}

enum DayStatus {
  OK
  INCONSISTENT
  OPEN
  ABSENT
}

enum ClosingStatus {
  CLOSED
  REOPENED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  username           String     @unique
  passwordHash       String
  role               Role
  active             Boolean    @default(true)
  mustChangePassword Boolean    @default(true)
  mfaSecret          String?
  mfaEnabled         Boolean    @default(false)
  recoveryCodes      String[]
  createdAt          DateTime   @default(now()) @db.Timestamptz
  updatedAt          DateTime   @updatedAt @db.Timestamptz
  sessions           Session[]
  audits             AuditLog[]
}

model Session {
  id         String   @id
  userId     String   @db.Uuid
  csrfToken  String
  createdAt  DateTime @default(now()) @db.Timestamptz
  lastSeenAt DateTime @default(now()) @db.Timestamptz
  expiresAt  DateTime @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model KioskDevice {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  tokenHash  String       @unique
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now()) @db.Timestamptz
  revokedAt  DateTime?    @db.Timestamptz
  records    TimeRecord[]
}

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  employees Employee[]
}

model Position {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  employees Employee[]
}

model WorkSchedule {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @unique
  dailyMinutes     Int
  breakMinutes     Int
  toleranceMinutes Int
  workDays         Int[]      @default([1, 2, 3, 4, 5])
  employees        Employee[]
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  employeeCode   String         @unique
  fullName       String
  pinLookup      String?        @unique
  pinHash        String?
  positionId     String         @db.Uuid
  departmentId   String         @db.Uuid
  workScheduleId String         @db.Uuid
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz
  position       Position       @relation(fields: [positionId], references: [id], onDelete: Restrict)
  department     Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  workSchedule   WorkSchedule   @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  records        TimeRecord[]
  summaries      DailySummary[]
}

model TimeRecord {
  id                String       @id @default(uuid()) @db.Uuid
  seq               Int          @unique @default(autoincrement())
  employeeId        String       @db.Uuid
  recordedAt        DateTime     @db.Timestamptz
  recordDate        String       @db.Char(10)
  recordTime        String       @db.Char(8)
  type              RecordType
  source            RecordSource
  deviceId          String?      @db.Uuid
  createdByUserId   String?      @db.Uuid
  cancelledAt       DateTime?    @db.Timestamptz
  cancelledByUserId String?      @db.Uuid
  cancelReason      String?
  integrityHash     String
  createdAt         DateTime     @default(now()) @db.Timestamptz
  updatedAt         DateTime     @updatedAt @db.Timestamptz
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device            KioskDevice? @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([employeeId, recordedAt])
  @@index([recordDate])
}

model DailySummary {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @db.Uuid
  date            String    @db.Char(10)
  firstEntry      String?   @db.Char(8)
  lastExit        String?   @db.Char(8)
  workedMinutes   Int
  expectedMinutes Int
  overtimeMinutes Int
  deficitMinutes  Int
  status          DayStatus
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, date])
  @@index([date])
}

model MonthlyClosing {
  id           String        @id @default(uuid()) @db.Uuid
  year         Int
  month        Int
  status       ClosingStatus
  closedBy     String        @db.Uuid
  closedAt     DateTime      @db.Timestamptz
  reopenedBy   String?       @db.Uuid
  reopenedAt   DateTime?     @db.Timestamptz
  reopenReason String?

  @@unique([year, month])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model RateLimitEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([key, createdAt])
  @@index([createdAt])
}
